<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- A launch stand that turns telardo's fireworks into a REAL recreation source. In his mod
       they are either an Ideology ritual or a single-use item set off from a gizmo - and with
       Ideology active the gizmo is not even created:

           if (ModsConfig.IdeologyActive) yield break;   // CompLaunchFireworks

       Here colonists go of their own accord, as recreation, and the stand fires while they watch.

       WHY EVERYTHING SITS INSIDE A GUARDED PATCH. These defs name `FireworkLauncher` and the class
       `Fireworks.CompLaunchFireworks`: without the original mod, an unresolved `<li Class="...">`
       would fail the ENTIRE def, and the fuel filter would point at nothing. So the guard is on
       the existence of his item, the most direct test there is.

       WHAT IS OURS, AND THE ONLY THING THAT IS: a new KIND of recreation. That is the scarce
       commodity - expectations ask for up to six, and the base game offers only eight, four of
       which come from buildings. The show itself (bursts, trails, sub-emitters, sounds) stays
       telardo's, called as it is. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="FireworkLauncher"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs</xpath>
      <value>

        <JoyKindDef>
          <defName>FS_Fireworks</defName>
          <label>fireworks</label>
        </JoyKindDef>

        <ThingDef ParentName="BuildingBase">
          <defName>FS_FireworkStand</defName>
          <label>firework stand</label>
          <description>A braced rack that holds a stack of firework launchers and sets them off one at a time. Colonists gather at a distance to watch, and the show only runs while somebody is there to see it.\n\nMust be built under open sky.</description>
          <thingClass>Building</thingClass>
          <graphicData>
            <texPath>Things/Item/FireworkLauncher</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.6,1.6)</drawSize>
            <shadowData>
              <volume>(0.4, 0.5, 0.4)</volume>
            </shadowData>
          </graphicData>
          <size>(1,1)</size>
          <altitudeLayer>Building</altitudeLayer>
          <rotatable>false</rotatable>
          <passability>PassThroughOnly</passability>
          <pathCost>40</pathCost>
          <fillPercent>0.35</fillPercent>
          <tickerType>Normal</tickerType>
          <minifiedDef>MinifiedThing</minifiedDef>
          <thingCategories>
            <li>BuildingsJoy</li>
          </thingCategories>
          <socialPropernessMatters>true</socialPropernessMatters>
          <building>
            <joyKind>FS_Fireworks</joyKind>
            <!-- Fireworks are watched from far away and face on, like a television. The range is
                 wider: it can be seen from the other end of the colony. -->
            <watchBuildingStandDistanceRange>4~12</watchBuildingStandDistanceRange>
            <watchBuildingStandRectWidth>5</watchBuildingStandRectWidth>
          </building>
          <statBases>
            <MaxHitPoints>120</MaxHitPoints>
            <WorkToBuild>4000</WorkToBuild>
            <Mass>15</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>4</Beauty>
            <JoyGainFactor>1.4</JoyGainFactor>
          </statBases>
          <costList>
            <Steel>40</Steel>
            <WoodLog>20</WoodLog>
          </costList>
          <researchPrerequisites>
            <li>IEDs</li>
          </researchPrerequisites>
          <comps>
            <li Class="CompProperties_Refuelable">
              <!-- The fuel is its firework launchers. fuelConsumptionRate at 0: nothing burns on
                   its own, our comp removes one rocket per salvo. -->
              <fuelConsumptionRate>0</fuelConsumptionRate>
              <fuelCapacity>10</fuelCapacity>
              <fuelFilter>
                <thingDefs>
                  <li>FireworkLauncher</li>
                </thingDefs>
              </fuelFilter>
              <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
              <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
              <!-- No showFuelGizmo here: the field still exists on CompProperties_Refuelable in
                   1.6, and nothing in the game reads it any more. Writing it would be writing a
                   comment. The gauge shows regardless. -->
              <atomicFueling>false</atomicFueling>
              <fuelLabel>Fireworks loaded</fuelLabel>
              <outOfFuelMessage>No fireworks loaded</outOfFuelMessage>
            </li>
            <!-- telardo's comp, put on a building. Checked by decompilation: its Launch method
                 only reads the position and map of its holder, and does not destroy it. Our comp
                 sets its `launched` field back to false before each salvo, which turns a one-shot
                 launcher into a reusable stand. -->
            <li>
              <compClass>Fireworks.CompLaunchFireworks</compClass>
            </li>
            <!-- The light. It is OFF by default, and that is the whole point:
                 `CompGlower.ShouldBeLitNow` asks every comp on the building that implements
                 `IThingGlower` and gives up as soon as one says no. Ours is one of them, and only
                 says yes for the four seconds following a rocket's departure. Without that veto a
                 loaded stand would stay lit permanently like a lamp - `ShouldBeLitNow` consults
                 neither fuel nor power, checked by decompilation. -->
            <li Class="CompProperties_Glower">
              <glowRadius>9</glowRadius>
              <glowColor>(255,220,150,0)</glowColor>
            </li>
            <li Class="FireworkStand.CompProperties_FireworkStand">
              <shotInterval>900</shotInterval>
              <launchDelay>60</launchDelay>
              <moodRadius>20</moodRadius>
              <flashTicks>240</flashTicks>
              <smokeInterval>5</smokeInterval>
            </li>
          </comps>
          <placeWorkers>
            <li>PlaceWorker_WatchArea</li>
          </placeWorkers>
          <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
          <designationCategory>Joy</designationCategory>
        </ThingDef>

        <JobDef>
          <defName>FS_WatchFireworks</defName>
          <driverClass>FireworkStand.JobDriver_WatchFireworks</driverClass>
          <reportString>watching fireworks.</reportString>
          <joyDuration>4000</joyDuration>
          <joyMaxParticipants>10</joyMaxParticipants>
          <joyKind>FS_Fireworks</joyKind>
        </JobDef>

        <JoyGiverDef>
          <defName>FS_WatchFireworks</defName>
          <giverClass>FireworkStand.JoyGiver_WatchFireworkStand</giverClass>
          <baseChance>3</baseChance>
          <!-- unroofedOnly: `JoyGiver_InteractBuilding.CanInteractWith` refuses a roofed building
               when this field is true. That is what the vanilla telescope uses, and it applies at
               least as much to fireworks. -->
          <unroofedOnly>true</unroofedOnly>
          <!-- desireSit false: you stand up to watch fireworks, you do not go looking for a chair.
               Without this, a stand out in a field would sit unused. -->
          <desireSit>false</desireSit>
          <thingDefs>
            <li>FS_FireworkStand</li>
          </thingDefs>
          <jobDef>FS_WatchFireworks</jobDef>
          <joyKind>FS_Fireworks</joyKind>
          <requiredCapacities>
            <li>Sight</li>
          </requiredCapacities>
        </JoyGiverDef>

      </value>
    </match>
  </Operation>

</Patch>
