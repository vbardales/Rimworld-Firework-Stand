<Project>

  <PropertyGroup>
    <!--
      Build intermediates go outside the mod folder. RimWorld's Workshop uploader sends the whole
      directory (SteamUGC.SetItemContent on the root, no exclusion possible): leaving obj/ inside
      means publishing the 5.8 MB publicised Assembly-CSharp.dll, and so redistributing the game's
      own code. This has to live in a Directory.Build.props: NuGet restore reads the property
      before the csproj. The path stops at this repository's own .build/ - it used to reach one
      level further, into the monorepo this mod has left.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\FireworkStand\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\FireworkStand\</BaseOutputPath>
  </PropertyGroup>

</Project>
