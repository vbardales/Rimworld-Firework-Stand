<?xml version="1.0" encoding="utf-8"?>
<!--
  Seed for the gallery passes: Show Hair Under Stuff (RaccoonCuddler.ShowHair, 3255379190), 2026-10-18.
  Why: ShowHairSettings declares showUnderUpperHeadGear and showUnderFullHeadGear without an initial value (false). The "true" default of
  ExposeData only applies when a settings file exists. With no file, both options are off and the hat hides the hair (run hat-hair-1, 2026-10-18:
  no hair under the cowboy hat). Both set to True here, which is what the description says the mod does by default.
-->
<SettingsBlock>
  <ModSettings Class="ShowHair.ShowHairSettings">
    <showUnderUpperHeadGear>True</showUnderUpperHeadGear>
    <showUnderFullHeadGear>True</showUnderFullHeadGear>
  </ModSettings>
</SettingsBlock>
